# Copie este arquivo para ".env" e ajuste conforme necessario.
# O ".env" nao deve ser commitado (ja esta no .gitignore).

# Parte do titulo da janela do SRI, usada para localiza-la.
TITULO_JANELA_SRI=SRI

# Enquanto "true", rpa_sri.py recusa selecionar escrevente ou salvar.
# So mude para "false" depois de validar manualmente as fases anteriores.
MODO_SEGURO=true
