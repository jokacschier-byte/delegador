# Copie para ".env" dentro de saas/ e ajuste para produção.
# Nunca commite o ".env" real (já está no .gitignore).

DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=

# --- Só em produção (Railway preenche DATABASE_URL sozinho ao linkar o Postgres) ---
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.registrai.com.br

# --- E-mail (recuperação de senha). Sem isso, o link só aparece no log do servidor. ---
# Exemplo com Resend (resend.com -- crie uma API key em "API Keys"):
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_sua_api_key_aqui
# DEFAULT_FROM_EMAIL=registrai <nao-responda@seu-dominio-verificado.com.br>
